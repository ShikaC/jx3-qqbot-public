# Windows 本机一体化部署配置（NapCat + AstrBot 都跑在本机，无 SSH 隧道）
#
# 一般用户不需要手动改这个文件：双击项目根目录的 install.cmd 会自动生成 .env。
# 想手动部署时，复制成 .env 后按实际路径和凭据修改。.env 不入库。

# --- NapCat（QQ 协议端） ---

# OneKey 安装出来的 NapCat Shell 目录（含 napcat.bat / NapCatWinBootMain.exe）。
# 留空时 setup.ps1 会自动下载安装到 .runtime\onekey-install。
NAPCAT_ROOT=

# NapCat 的配置目录；留空时由 setup-napcat.ps1 自动查找
NAPCAT_CONFIG_DIR=

# NapCat WebUI：只监听本机，扫码和配置用
NAPCAT_WEBUI_HOST=127.0.0.1
NAPCAT_WEBUI_PORT=6099
NAPCAT_WEBUI_TOKEN=replace-with-random-token

# 可选：机器人小号 QQ 号。填了就在启动时走 OneKey 快速登录（登录态存在时免扫码）
NAPCAT_QQ_ACCOUNT=

# --- OneBot v11 ---

# NapCat 作为 WS 客户端，直连本机 AstrBot 的反向 WS 端口
ONEBOT_WS_URL=ws://127.0.0.1:6199/ws
ONEBOT_WS_TOKEN=replace-with-random-token
# AstrBot 侧监听的端口，start.ps1 会把两端对齐成同一个值
ONEBOT_WS_PORT=6199

# --- AstrBot（本机实例） ---

# AstrBot 数据根目录；留空时用仓库下的 .runtime\astrbot
ASTRBOT_ROOT=
# AstrBot 启动器；留空时用仓库下的 .venv\Scripts\astrbot.exe
ASTRBOT_EXE=
# 管理后台端口（AstrBot Dashboard）
ASTRBOT_DASHBOARD_PORT=6185
# 管理后台账号与密码；setup.ps1 会自动生成随机密码
ASTRBOT_DASHBOARD_USERNAME=astrbot
ASTRBOT_DASHBOARD_PASSWORD=replace-with-strong-password
